(define (problem rescue-mission-4x4-with-obstacles)
  (:domain drone-rescue)
  (:objects
    loc1 loc2 loc3 loc4 - location  ;; Row 1 (0-indexed row)
    loc5 loc6 loc7 loc8 - location  ;; Row 2 (1-indexed row)
